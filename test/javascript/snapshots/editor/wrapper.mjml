<mjml>
  <mj-head>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#111827" />
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#f3f4f6" css-class="tess-b1">
    <mj-wrapper padding="20px 0px" background-color="#ffffff" css-class="tess-b2">
      <mj-section padding="20px 0px" css-class="tess-b3">
        <mj-column css-class="tess-b4">
          <mj-text css-class="tessph-b4" align="center" color="#94a3b8" font-size="13px" padding="18px 25px">Drop content here</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>