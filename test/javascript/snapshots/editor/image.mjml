<mjml>
  <mj-head>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#111827" />
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#f3f4f6" css-class="tess-b1">
    <mj-section padding="20px 0px" css-class="tess-b2">
      <mj-column css-class="tess-b3">
        <mj-image src="https://placehold.co/1200x600/e5e7eb/9ca3af.png?text=Image" padding="10px 25px" css-class="tess-b4" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>