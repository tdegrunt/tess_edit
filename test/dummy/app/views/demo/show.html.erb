<% content_for :title, "TessEdit demo" %>

<%= form_with url: demo_path, method: :post, class: "flex h-screen flex-col gap-3 p-4" do |form| %>
  <div class="flex items-center gap-3">
    <h1 class="text-lg font-semibold text-gray-900">TessEdit</h1>
    <p class="text-sm text-gray-500">Drag blocks onto the canvas, select them to change their settings, double-click text to edit it.</p>
    <%= form.submit "Submit form", class: "ml-auto rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-50" %>
  </div>

  <%# ?panels=left or ?panels=right sets the default panel layout. ?lock=1 opens
      a layout with only its Content block, subject and preview text editable.
      ?media=1 lets Image blocks choose and upload images (MediaController).
      ?variables=1 suggests an order template's Liquid variables (VariablesController).
      ?translations=1 shows and edits translations for Liquid's t filter (TranslationsController). %>
  <% locked = params[:lock].present? %>
  <div class="min-h-0 flex-1" data-controller="tess-edit" data-tess-edit-panels-value="<%= params[:panels] %>"
    <% if params[:media].present? %>data-tess-edit-media-url-value="<%= media_path %>"<% end %>
    <% if params[:variables].present? %>data-tess-edit-variables-url-value="<%= variables_path %>"<% end %>
    <% if params[:translations].present? %>data-tess-edit-translations-url-value="<%= translations_path %>"<% end %>
    <% if locked %>
      data-tess-edit-document-value="<%= Rails.root.join("config/demo_layout.json").read %>"
      data-tess-edit-lock-value="<%= {except: ["content"], fields: ["data.subject", "data.preheader"]}.to_json %>"
    <% end %>>
    <%= hidden_field_tag :json, nil, data: { tess_edit_target: "jsonInput" } %>
    <%= hidden_field_tag :mjml, nil, data: { tess_edit_target: "mjmlInput" } %>
    <%= hidden_field_tag :html, nil, data: { tess_edit_target: "htmlInput" } %>
  </div>
<% end %>
